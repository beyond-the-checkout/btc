{
  "extends": "../tsconfig/base.json",
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "../utils/**/*"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "react": ["./node_modules/@types/react"]
    }
  }
}